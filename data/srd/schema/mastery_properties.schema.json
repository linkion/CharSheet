{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SRD 5.2.1 mastery_properties",
 "type": "array",
 "items": {
  "type": "object",
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^mastery_property:[a-z0-9-]+$"
   },
   "name": {
    "type": "string"
   },
   "category": {
    "const": "mastery_property"
   },
   "page": {
    "type": "integer",
    "minimum": 5,
    "maximum": 364
   },
   "summary": {
    "type": "string"
   },
   "markdown": {
    "type": "string",
    "description": "Markdown"
   }
  },
  "required": [
   "id",
   "name",
   "category",
   "page",
   "summary",
   "markdown"
  ],
  "additionalProperties": false
 }
}
